# Deny by default; new root files need review.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!next.config.ts
!next-env.d.ts
!tsconfig.json
!postcss.config.mjs
!eslint.config.mjs
!prisma/
!prisma/schema.prisma
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/**
# Exclusions apply inside allowlisted trees too.
**/.env
**/.env.*
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/.git
**/.git/**
**/.ssh
**/.ssh/**
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/id_dsa*
**/*.pem
**/*.key
**/*.ppk
**/*.p12
**/*.pfx
**/*.log
**/*.log.*
**/logs
**/logs/**
**/backup*
**/backup*/**
**/*.bak
**/*.dump
**/*.dump.gz
**/*.backup
**/*.pgdump
**/*.sql
**/*.sql.gz
**/*.sqlite*
**/*.db
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/tmp
**/tmp/**
**/temp
**/temp/**
